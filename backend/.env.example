# =============================================================================
# AlzCare Platform - Environment Variables (template)
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# =============================================================================

# Databases
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Identity Service
IDENTITY_SERVICE_PORT=8001
POSTGRES_IDENTITY_PORT=5432
POSTGRES_IDENTITY_DB=alzcare_identity

# Third-party integrations (leave empty to disable)
TOMTOM_API_KEY=
AIRVISUAL_API_KEY=
NEWS_API_KEY=
