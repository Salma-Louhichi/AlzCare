# =============================================================================
# AlzCare Platform - Environment Variables (template)
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# =============================================================================

# Databases
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Identity Service
IDENTITY_SERVICE_PORT=8001
POSTGRES_IDENTITY_PORT=5432
POSTGRES_IDENTITY_DB=alzcare_identity

# Third-party integrations (leave empty to disable)
TOMTOM_API_KEY=
AIRVISUAL_API_KEY=
NEWS_API_KEY=

# Infrastructure credentials (dev defaults are used when unset - override outside local dev)
CONFIG_SERVER_USERNAME=config
CONFIG_SERVER_PASSWORD=change-me
RABBITMQ_USERNAME=alzcare
RABBITMQ_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Gateway CORS (comma-separated origin patterns)
ALZCARE_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:4200

# Host ports (change if something else on your machine already uses them)
GATEWAY_HOST_PORT=8080
MONGO_HOST_PORT=27017

# Keycloak client secret of event-ingestion (must match the "alzcare-event-ingestion" client)
EVENT_INGESTION_CLIENT_SECRET=change-me
