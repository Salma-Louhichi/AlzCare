// Copy to secrets.h (git-ignored) and fill in. The device id and key are shown once,
// when the camera is paired in AlzCare (Admin › Medical › Cameras).
#pragma once

#define WIFI_SSID      "your-wifi"
#define WIFI_PASSWORD  "your-wifi-password"

// Gateway URL reachable from the device (use https:// and a root CA in production)
#define ALZCARE_EVENTS_URL "http://192.168.1.10:8080/api/events"

#define DEVICE_ID  "00000000-0000-0000-0000-000000000000"
#define DEVICE_KEY "paste-the-device-key-shown-at-pairing"
